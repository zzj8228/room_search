[Unit]
Description=Refresh PKU classroom catalog
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=roomsearch
Group=roomsearch
WorkingDirectory=/opt/room-search
Environment="PKU_CLASSROOM_DATABASE_URL=host=/var/run/postgresql dbname=pku_classroom user=roomsearch"
Environment=PKU_CLASSROOM_DATA_DIR=/var/lib/room-search
ExecStart=/opt/room-search/.venv/bin/python deploy/sync_recent.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/room-search
