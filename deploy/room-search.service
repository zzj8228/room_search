[Unit]
Description=PKU classroom public read-only search
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=roomsearch
Group=roomsearch
WorkingDirectory=/opt/room-search
Environment="PKU_CLASSROOM_DATABASE_URL=host=/var/run/postgresql dbname=pku_classroom user=roomsearch"
Environment=PKU_CLASSROOM_DATA_DIR=/var/lib/room-search
ExecStart=/opt/room-search/.venv/bin/python classroom.py serve --public-origin http://10.129.81.32
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/room-search
MemoryMax=384M

[Install]
WantedBy=multi-user.target
