[Unit]
Description=Private virtual desktop for PKU official login
After=network.target

[Service]
User=roomsearch
Group=roomsearch
Environment=HOME=/var/lib/room-search
Environment=DISPLAY=:99
ExecStart=/bin/bash /opt/room-search/deploy/desktop.sh
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/room-search /tmp
MemoryMax=256M

[Install]
WantedBy=multi-user.target
